{
  "name": "coding-effectiveness-tracker",
  "version": "0.1.0",
  "description": "Local-first coding effectiveness tracker for AI-assisted development",
  "type": "module",
  "bin": {
    "cet": "./bin/cli.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc && vite build",
    "build:server": "tsc",
    "build:dashboard": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude tests/e2e.test.ts",
    "test:e2e": "vitest run --reporter=verbose tests/e2e.test.ts",
    "dev": "tsx src/cli.ts",
    "dev:local": "vite build && tsx src/cli.ts serve"
  },
  "keywords": [
    "coding",
    "effectiveness",
    "tracker",
    "ai",
    "local-first",
    "productivity",
    "cli",
    "git",
    "analytics"
  ],
  "author": "Tafheem Malik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TafheemMalik/coding-effectiveness-tracker.git"
  },
  "homepage": "https://github.com/TafheemMalik/coding-effectiveness-tracker#readme",
  "bugs": {
    "url": "https://github.com/TafheemMalik/coding-effectiveness-tracker/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "better-sqlite3": "^12.9.0",
    "commander": "^14.0.3",
    "fastify": "^5.8.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
